import sys
from collections import defaultdict

def main():
    sys.setrecursionlimit(1 << 25)
    
    n, m = map(int, input().split())
    grid = [list(map(int, input().split())) for _ in range(n)]
    
    # Union-Find data structure
    parent = [i for i in range(n * m)]
    
    def find(x):
        if parent[x] != x:
            parent[x] = find(parent[x])
        return parent[x]
    
    def union(x, y):
        px, py = find(x), find(y)
        if px != py:
            parent[px] = py

    dirs = [(-1,0),(1,0),(0,-1),(0,1)]

    # Step 1: Union equal-height adjacent cells
    # Cells with same height that are adjacent can be treated as one component
    for i in range(n):
        for j in range(m):
            for dx, dy in dirs:
                ni, nj = i + dx, j + dy
                if 0 <= ni < n and 0 <= nj < m and grid[ni][nj] == grid[i][j]:
                    union(i * m + j, ni * m + nj)

    # Step 2: Build DAG with edges from higher to lower component
    # Create directed edges between components based on height differences
    dag = defaultdict(set)
    indegree = defaultdict(int)

    for i in range(n):
        for j in range(m):
            u = find(i * m + j)  # Component of current cell
            for dx, dy in dirs:
                ni, nj = i + dx, j + dy
                if 0 <= ni < n and 0 <= nj < m:
                    v = find(ni * m + nj)  # Component of neighbor
                    # Add edge from lower component to higher component
                    # Alice can move from lower height to higher height
                    if u != v and grid[ni][nj] > grid[i][j]:
                        if v not in dag[u]:
                            dag[u].add(v)
                            indegree[v] += 1

    # Step 3: Count number of component roots (indegree 0)
    # These are the components that cannot be reached from any other component
    roots = set(find(i) for i in range(n * m))
    answer = 0
    for node in roots:
        if indegree[node] == 0:
            answer += 1

    print(answer)

if __name__ == "__main__":
    main()


"""
EXPLANATION:

This solution uses a brilliant insight: the problem is equivalent to finding the number of 
"source" components in a directed acyclic graph (DAG).

Key insights:
1. Group adjacent cells with equal heights into components using Union-Find
2. Build a DAG where edges go from lower-height components to higher-height components
3. The answer is the number of components with indegree 0 (source components)

Why this works:
- Alice can move from a cell to an adjacent cell with equal or higher height
- This means she can move freely within a component (equal heights)
- She can also move from a lower component to a higher component
- To guarantee reaching any cell, she must start from a component that has no incoming edges
  (i.e., cannot be reached from any other component)
- The minimum number of such starting points is the number of source components

Time Complexity: O(nm) with Union-Find optimizations
Space Complexity: O(nm)

Example walkthrough for Sample 2:
Grid:
1 2 2
2 1 1  
2 1 1

After grouping equal heights:
- Component A: cells with height 1 (positions (0,0), (1,1), (1,2), (2,1), (2,2))
- Component B: cells with height 2 (positions (0,1), (0,2), (1,0), (2,0))

DAG edges: A → B (height 1 can reach height 2)
Indegrees: A=0, B=1

But component A is not connected as a single component! Let me reconsider...

Actually, looking at the grid more carefully:
- (0,0) with height 1 is isolated from other height-1 cells
- (1,1), (1,2), (2,1), (2,2) form one connected component of height 1
- (0,1), (0,2) form one connected component of height 2  
- (1,0), (2,0) form another connected component of height 2

So we have 4 components, and the analysis shows we need 2 source components.

Wait, let me reconsider the movement rules...
"""